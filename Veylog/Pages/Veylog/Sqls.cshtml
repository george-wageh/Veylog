@page "/veylog/sqls"
@model Veylog.Pages.SqlsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@{
    ViewData["Title"] = "SQL Calls";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>SQL Calls</h1>

        <div>

            <a href="/veylog"
               class="btn btn-secondary">
                Dashboard
            </a>

            <a href="/veylog/apis"
               class="btn btn-primary">
                API Requests
            </a>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>
                SQL Traces
            </span>

            <span class="text-muted">
                @Model.TotalGroups traces
            </span>

        </div>


        <div class="accordion" id="traceAccordion">

            @if (!Model.Groups.Any())
            {
                <div class="card-body text-center text-muted">
                    No SQL calls found.
                </div>
            }


            @for (var i = 0; i < Model.Groups.Count; i++)
            {
                var group = Model.Groups[i];

                <div class="accordion-item">

                    <h2 class="accordion-header"
                        id="trace-heading-@i">

                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#trace-@i">

                            <div class="w-100">

                                <div class="d-flex align-items-center gap-3">

                                    <strong>
                                        Trace:
                                    </strong>

                                    <code>
                                        @group.TraceId
                                    </code>

                                    @if (group.HasError)
                                    {
                                        <span class="badge bg-danger">
                                            Has Error
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Success
                                        </span>
                                    }

                                </div>

                                <div class="small text-muted mt-2">

                                    @group.Count SQL calls

                                    &nbsp; | &nbsp;

                                    @group.TotalDuration ms total

                                    &nbsp; | &nbsp;

                                    @(group.FirstCreatedAt
                                    .ToString("yyyy-MM-dd HH:mm:ss.fff"))

                                    -

                                    @(group.LastCreatedAt
                                    .ToString("HH:mm:ss.fff"))

                                </div>

                            </div>

                        </button>

                    </h2>


                    <div id="trace-@i"
                         class="accordion-collapse collapse"
                         data-bs-parent="#traceAccordion">

                        <div class="accordion-body p-0">

                            @foreach (var sql in group.Logs)
                            {
                                <div class="border-bottom p-4">

                                    <div class="d-flex justify-content-between align-items-center mb-3">

                                        <div>

                                            <strong>
                                                @sql.SqlOperation
                                            </strong>

                                            <span class="text-muted ms-2">
                                                @sql.CreatedAt
                                                .ToString("HH:mm:ss.fff")
                                            </span>

                                        </div>

                                        <div>

                                            @if (sql.IsSuccess)
                                            {
                                                <span class="badge bg-success">
                                                    Success
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Failed
                                                </span>
                                            }

                                            <span class="badge bg-secondary">
                                                @sql.ElapsedMilliseconds ms
                                            </span>

                                        </div>

                                    </div>


                                    <h6>
                                        SQL
                                    </h6>

                                    <pre class="bg-dark text-light p-3"
                                         style="max-height:400px;overflow:auto;white-space:pre-wrap;">@sql.CommandText</pre>


                                    @if (!string.IsNullOrWhiteSpace(sql.Parameters))
                                    {
                                        <h6>
                                            Parameters
                                        </h6>

                                        <pre class="bg-light p-3"
                                             style="max-height:300px;overflow:auto;white-space:pre-wrap;">@sql.Parameters</pre>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(sql.Exception))
                                    {
                                        <h6 class="text-danger">
                                            Exception
                                        </h6>

                                        <pre class="bg-dark text-danger p-3"
                                             style="max-height:300px;overflow:auto;white-space:pre-wrap;">@sql.Exception</pre>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">

                    <!-- Page Information -->

                    <div class="text-muted small">

                        Page
                        <strong>@(Model.PageNumber)</strong>
                        of
                        <strong>@(Model.TotalPages)</strong>

                    </div>


                    <nav aria-label="SQL pagination">

                        <ul class="pagination mb-0">


                            <!-- First -->

                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">

                                @if (Model.PageNumber > 1)
                                {
                                    <a class="page-link"
                                       asp-page="/Veylog/Sqls"
                                       asp-route-pageNumber="1">

                                        First

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        First
                                    </span>
                                }

                            </li>


                            <!-- Previous -->

                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">

                                @if (Model.PageNumber > 1)
                                {
                                    <a class="page-link"
                                       asp-page="/Veylog/Sqls"
                                       asp-route-pageNumber="@(Model.PageNumber - 1)">

                                        Previous

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        Previous
                                    </span>
                                }

                            </li>


                            @{
                                var startPage = Math.Max(
                                    1,
                                    Model.PageNumber - 2);

                                var endPage = Math.Min(
                                    Model.TotalPages,
                                    Model.PageNumber + 2);
                            }


                            <!-- First page + dots -->
                            @if (startPage > 1)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       asp-page="/Veylog/Sqls"
                                       asp-route-pageNumber="1">

                                        1

                                    </a>

                                </li>

                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">
                                            ...
                                        </span>

                                    </li>
                                }
                            }


                            <!-- Page Numbers -->
                            @for (
                                                            var pageNumber = startPage;
                                                            pageNumber <= endPage;
                                                            pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">

                                    <a class="page-link"
                                       asp-page="/Veylog/Sqls"
                                       asp-route-pageNumber="@pageNumber">

                                        @pageNumber

                                    </a>

                                </li>
                            }


                            <!-- Last page + dots -->
                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">
                                            ...
                                        </span>

                                    </li>
                                }

                                <li class="page-item">

                                    <a class="page-link"
                                       asp-page="/Veylog/Sqls"
                                       asp-route-pageNumber="@Model.TotalPages">

                                        @Model.TotalPages

                                    </a>

                                </li>
                            }


                            <!-- Next -->

                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">

                                @if (Model.PageNumber < Model.TotalPages)
                                {
                                    <a class="page-link"
                                       asp-page="/Veylog/Sqls"
                                       asp-route-pageNumber="@(Model.PageNumber + 1)">

                                        Next

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        Next
                                    </span>
                                }

                            </li>


                            <!-- Last -->

                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">

                                @if (Model.PageNumber < Model.TotalPages)
                                {
                                    <a class="page-link"
                                       asp-page="/Veylog/Sqls"
                                       asp-route-pageNumber="@Model.TotalPages">

                                        Last

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        Last
                                    </span>
                                }

                            </li>

                        </ul>

                    </nav>

                </div>

            </div>
        }

    </div>

</div>