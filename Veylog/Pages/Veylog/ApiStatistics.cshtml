@page "/veylog/api-statistics"
@model Veylog.Pages.ApiStatisticsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@using System.Text.Json

@{
    ViewData["Title"] = "API Statistics";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">API Statistics</h1>
            <div class="text-muted">Performance statistics for API requests</div>
        </div>
        <div class="d-flex gap-2">
            <a href="/veylog/apis" class="btn btn-outline-primary">API Requests</a>
            <a href="/veylog" class="btn btn-secondary">Dashboard</a>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">Search / Filters</div>
        <div class="card-body">
            <form method="get">
                <div class="row g-3">

                    <!-- API / Path -->
                    <div class="col-md-3">
                        <label class="form-label">API / Path</label>
                        <input type="text" class="form-control" name="Api" value="@Model.Api" placeholder="/api/users" />
                    </div>

                    <!-- Sort By -->
                    <div class="col-md-3">
                        <label class="form-label">Sort By</label>
                        @{
                            ViewBag.SortBy = Model.SortBy;
                        }
                        @await Html.PartialAsync("Shared/Components/SortByDropdown")
                    </div>

                    <!-- Top N APIs -->
                    <div class="col-md-2">
                        <label class="form-label">Show</label>
                        <select class="form-select" name="Top">
                            @foreach (var count in Model.AvailableTopCounts)
                            {
                                <option value="@count" selected="@(Model.Top == count)">Top @count</option>
                            }
                            <option value="0" selected="@(Model.Top == 0)">All</option>
                        </select>
                    </div>

                    <!-- Status Codes -->
                    <div class="col-md-4">
                        <label class="form-label">Status Codes</label>
                        <input type="text" class="form-control" name="StatusCodes" value="@Model.StatusCodes" placeholder="404, 401, 500" />
                        <div class="form-text">Enter multiple status codes separated by commas.</div>
                    </div>

                    <!-- HTTP Methods (modern pill-style multi-select, no Ctrl needed) -->
                    <div class="col-md-6">
                        <label class="form-label d-block">
                            HTTP Method
                        </label>

                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var method in Model.AvailableMethods)
                            {
                                var isChecked = string.Equals(Model.Method, method);

                                <input type="radio"
                                       class="btn-check"
                                       name="Method"
                                       value="@method"
                                       id="method_@method"
                                       autocomplete="off"
                                       checked="@(isChecked ? "checked" : null)" />

                                <label class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                       for="method_@method">
                                    @method
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Search -->
                    <div class="col-md-4">
                        <label class="form-label">Search</label>
                        <input type="text" class="form-control" name="Search" value="@Model.Search" placeholder="Path, request or response..." />
                    </div>

                    <!-- Request Body -->
                    <div class="col-md-4">
                        <label class="form-label">Request Body</label>
                        <input type="text" class="form-control" name="RequestBody" value="@Model.RequestBody" placeholder="Search request body..." />
                    </div>

                    <!-- Response Body -->
                    <div class="col-md-4">
                        <label class="form-label">Response Body</label>
                        <input type="text" class="form-control" name="ResponseBody" value="@Model.ResponseBody" placeholder="Search response body..." />
                    </div>

                    <!-- Daily From -->
                    <div class="col-md-2">
                        <label class="form-label">Daily From</label>
                        <input type="date" class="form-control" name="DailyFrom" value="@Model.DailyFrom?.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Daily To -->
                    <div class="col-md-2">
                        <label class="form-label">Daily To</label>
                        <input type="date" class="form-control" name="DailyTo" value="@Model.DailyTo?.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Monthly Year -->
                    <div class="col-md-2">
                        <label class="form-label">Monthly Year</label>
                        <select class="form-select" name="MonthlyYear">
                            @foreach (var year in Model.AvailableYears)
                            {
                                <option value="@year" selected="@(Model.MonthlyYear == year)">@year</option>
                            }
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Search</button>
                        <a href="/veylog/api-statistics" class="btn btn-outline-secondary">Clear</a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Result Summary -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted small">APIs</div>
                        <div class="fs-3 fw-bold">
                            @Model.DisplayedApis
                            @if (Model.Top > 0 && Model.TotalApis > Model.DisplayedApis)
                            {
                                <span class="fs-6 fw-normal text-muted">of @Model.TotalApis</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Requests</div>
                        <div class="fs-3 fw-bold">@Model.TotalRecords</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Sorted By</div>
                        <div class="fs-5 fw-bold">
                            @switch (Model.SortBy)
                            {
                                case "frequency":
                                <span>Most Frequent</span>
                                break;
                                case "average":
                                <span>Average Response Time</span>
                                break;
                                case "min":
                                <span>Minimum Response Time</span>
                                break;
                                case "max":
                                <span>Maximum Response Time</span>
                                break;
                                case "path":
                                <span>API Path</span>
                                break;
                                default:
                                <span>Most Frequent</span>
                                break;
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- No Results -->
    @if (!Model.Statistics.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <div class="fs-4 mb-2">No API statistics found.</div>
                <div>Try changing your filters.</div>
            </div>
        </div>
    }

    <!-- API Statistics -->
    @for (var i = 0; i < Model.Statistics.Count; i++)
    {
        var api = Model.Statistics[i];
        var isFirst = i == 0;

        <details class="card shadow-sm mb-4" @(Model.Statistics.Count == 1 || isFirst ? "open" : null)>

            <!-- Header -->
            <summary class="card-header" style="cursor: pointer;">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fw-bold fs-5">@api.Path</span>
                        <span class="badge bg-dark">@api.TotalRequests requests</span>
                    </div>
                    <div class="d-flex gap-3 text-muted">
                        <span>Min: <strong>@api.Overall.Min ms</strong></span>
                        <span>Avg: <strong>@api.Overall.Average.ToString("0.##") ms</strong></span>
                        <span>Max: <strong>@api.Overall.Max ms</strong></span>
                    </div>
                </div>
            </summary>

            <!-- Body -->
            <div class="card-body">

                <!-- Overall Section -->
                <div class="mb-4">
                    <h5 class="mb-3">Overall</h5>
                    <div class="row g-3">
                        @{
                            ViewBag.Label = "Requests";
                            ViewBag.Value = api.Overall.Count;
                            ViewBag.Unit = "";
                            ViewBag.TextClass = "text-dark";
                        }
                        @await Html.PartialAsync("Shared/Components/MetricCard")

                        @{
                            ViewBag.Label = "Minimum";
                            ViewBag.Value = api.Overall.Min;
                            ViewBag.Unit = "ms";
                            ViewBag.TextClass = "text-success";
                            ViewBag.ActionUrl = api.Overall.MinId.HasValue ? $"/veylog/apis/{api.Overall.MinId.Value}" : "";
                            ViewBag.ActionText = "View Min Request";
                        }
                        @await Html.PartialAsync("Shared/Components/MetricCard")

                        @{
                            ViewBag.Label = "Average";
                            ViewBag.Value = api.Overall.Average.ToString("0.##");
                            ViewBag.Unit = "ms";
                            ViewBag.TextClass = "text-primary";
                            ViewBag.ActionUrl = "";
                        }
                        @await Html.PartialAsync("Shared/Components/MetricCard")

                        @{
                            ViewBag.Label = "Maximum";
                            ViewBag.Value = api.Overall.Max;
                            ViewBag.Unit = "ms";
                            ViewBag.TextClass = "text-danger";
                            ViewBag.ActionUrl = api.Overall.MaxId.HasValue ? $"/veylog/apis/{api.Overall.MaxId.Value}" : "";
                            ViewBag.ActionText = "View Max Request";
                        }
                        @await Html.PartialAsync("Shared/Components/MetricCard")
                    </div>
                </div>

                <!-- Daily Section -->
                @{
                    var dailyRows = api.Daily.Where(x => x.Count > 0).ToList();
                    var dailyMinPoint = dailyRows.OrderBy(x => x.Min).FirstOrDefault();
                    var dailyMaxPoint = dailyRows.OrderByDescending(x => x.Max).FirstOrDefault();
                }
                <div class="card border mb-4">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">Daily</h5>
                                <div class="text-muted small">@Model.DailyFrom?.ToString("yyyy-MM-dd") → @Model.DailyTo?.ToString("yyyy-MM-dd")</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-4">
                            @{
                                ViewBag.Label = "Minimum";
                                ViewBag.Value = dailyMinPoint?.Min ?? 0;
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-success";
                                ViewBag.ActionUrl = dailyMinPoint?.MinId.HasValue == true ? $"/veylog/apis/{dailyMinPoint.MinId.Value}" : "";
                                ViewBag.ActionText = "View Min Request";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")

                            @{
                                ViewBag.Label = "Average";
                                ViewBag.Value = dailyRows.Any() ? dailyRows.Average(x => x.Average).ToString("0.##") : "N/A";
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-primary";
                                ViewBag.ActionUrl = "";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")

                            @{
                                ViewBag.Label = "Maximum";
                                ViewBag.Value = dailyMaxPoint?.Max ?? 0;
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-danger";
                                ViewBag.ActionUrl = dailyMaxPoint?.MaxId.HasValue == true ? $"/veylog/apis/{dailyMaxPoint.MaxId.Value}" : "";
                                ViewBag.ActionText = "View Max Request";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")
                        </div>
                        <div style="height: 350px; position: relative;">
                            <canvas id="dailyChart_@i"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Monthly Section -->
                @{
                    var monthlyRows = api.Monthly.Where(x => x.Count > 0).ToList();
                    var monthlyMinPoint = monthlyRows.OrderBy(x => x.Min).FirstOrDefault();
                    var monthlyMaxPoint = monthlyRows.OrderByDescending(x => x.Max).FirstOrDefault();
                }
                <div class="card border mb-4">
                    <div class="card-header">
                        <h5 class="mb-1">Monthly</h5>
                        <div class="text-muted small">Year @Model.MonthlyYear</div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-4">
                            @{
                                ViewBag.Label = "Minimum";
                                ViewBag.Value = monthlyMinPoint?.Min ?? 0;
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-success";
                                ViewBag.ActionUrl = monthlyMinPoint?.MinId.HasValue == true ? $"/veylog/apis/{monthlyMinPoint.MinId.Value}" : "";
                                ViewBag.ActionText = "View Min Request";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")

                            @{
                                ViewBag.Label = "Average";
                                ViewBag.Value = monthlyRows.Any() ? monthlyRows.Average(x => x.Average).ToString("0.##") : "N/A";
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-primary";
                                ViewBag.ActionUrl = "";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")

                            @{
                                ViewBag.Label = "Maximum";
                                ViewBag.Value = monthlyMaxPoint?.Max ?? 0;
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-danger";
                                ViewBag.ActionUrl = monthlyMaxPoint?.MaxId.HasValue == true ? $"/veylog/apis/{monthlyMaxPoint.MaxId.Value}" : "";
                                ViewBag.ActionText = "View Max Request";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")
                        </div>
                        <div style="height: 350px; position: relative;">
                            <canvas id="monthlyChart_@i"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Yearly Section -->
                @{
                    var yearlyRows = api.Yearly.Where(x => x.Count > 0).ToList();
                    var yearlyMinPoint = yearlyRows.OrderBy(x => x.Min).FirstOrDefault();
                    var yearlyMaxPoint = yearlyRows.OrderByDescending(x => x.Max).FirstOrDefault();
                }
                <div class="card border">
                    <div class="card-header">
                        <h5 class="mb-1">Yearly</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-4">
                            @{
                                ViewBag.Label = "Minimum";
                                ViewBag.Value = yearlyMinPoint?.Min ?? 0;
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-success";
                                ViewBag.ActionUrl = yearlyMinPoint?.MinId.HasValue == true ? $"/veylog/apis/{yearlyMinPoint.MinId.Value}" : "";
                                ViewBag.ActionText = "View Min Request";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")

                            @{
                                ViewBag.Label = "Average";
                                ViewBag.Value = yearlyRows.Any() ? yearlyRows.Average(x => x.Average).ToString("0.##") : "N/A";
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-primary";
                                ViewBag.ActionUrl = "";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")

                            @{
                                ViewBag.Label = "Maximum";
                                ViewBag.Value = yearlyMaxPoint?.Max ?? 0;
                                ViewBag.Unit = "ms";
                                ViewBag.TextClass = "text-danger";
                                ViewBag.ActionUrl = yearlyMaxPoint?.MaxId.HasValue == true ? $"/veylog/apis/{yearlyMaxPoint.MaxId.Value}" : "";
                                ViewBag.ActionText = "View Max Request";
                            }
                            @await Html.PartialAsync("Shared/Components/MetricCard")
                        </div>
                        <div style="height: 350px; position: relative;">
                            <canvas id="yearlyChart_@i"></canvas>
                        </div>
                    </div>
                </div>

            </div>

        </details>
    }

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const chartInstances = {};

        // =========================================================
        // Create Statistics Chart
        // =========================================================

        function createStatisticsChart(
        canvasId,
        data,
        title) {

        const canvas = document.getElementById(canvasId);

        if (!canvas) {
        return;
        }

        // Destroy previous chart if exists
        if (chartInstances[canvasId]) {
        chartInstances[canvasId].destroy();
        delete chartInstances[canvasId];
        }

        // Safety
        if (!Array.isArray(data)) {
        data = [];
        }

        // Labels
        const labels = data.map(function (x) {
        return x.label;
        });

        // Min
        const minData = data.map(function (x) {
        return Number(x.min ?? 0);
        });

        // Average
        const avgData = data.map(function (x) {
        const value = Number(x.average ?? 0);
        return Number(value.toFixed(2));
        });

        // Max
        const maxData = data.map(function (x) {
        return Number(x.max ?? 0);
        });

        // Create Chart
        chartInstances[canvasId] =
        new Chart(canvas, {

        type: 'line',

        data: {

        labels: labels,

        datasets: [

        {
        label: 'Min',
        data: minData,
        borderColor: '#198754',
        backgroundColor: 'rgba(25, 135, 84, 0.08)',
        borderWidth: 2,
        pointRadius: 3,
        pointHoverRadius: 5,
        tension: 0.25,
        fill: false
        },

        {
        label: 'Average',
        data: avgData,
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13, 110, 253, 0.08)',
        borderWidth: 3,
        pointRadius: 4,
        pointHoverRadius: 6,
        tension: 0.25,
        fill: false
        },

        {
        label: 'Max',
        data: maxData,
        borderColor: '#dc3545',
        backgroundColor: 'rgba(220, 53, 69, 0.08)',
        borderWidth: 2,
        pointRadius: 3,
        pointHoverRadius: 5,
        tension: 0.25,
        fill: false
        }

        ]

        },

        options: {

        responsive: true,

        maintainAspectRatio: false,

        interaction: {
        mode: 'index',
        intersect: false
        },

        plugins: {

        title: {
        display: true,
        text: title
        },

        legend: {
        position: 'top'
        },

        tooltip: {
        callbacks: {
        label: function (context) {
        return context.dataset.label + ': ' + context.parsed.y + ' ms';
        }
        }
        }

        },

        scales: {

        y: {
        beginAtZero: true,
        title: {
        display: true,
        text: 'Time (ms)'
        }
        },

        x: {
        title: {
        display: true,
        text: 'Period'
        }
        }

        }

        }

        });

        }

        // =========================================================
        // Initialize Charts
        // =========================================================

        function initializeCharts() {

        @for (var i = 0; i < Model.Statistics.Count; i++)
        {
            var api = Model.Statistics[i];

            <text>

                createStatisticsChart(
                'dailyChart_@i',
                @Html.Raw(Model.ToJson(api.Daily)),
                'Daily API Response Time'
                );

                createStatisticsChart(
                'monthlyChart_@i',
                @Html.Raw(Model.ToJson(api.Monthly)),
                'Monthly API Response Time'
                );

                createStatisticsChart(
                'yearlyChart_@i',
                @Html.Raw(Model.ToJson(api.Yearly)),
                'Yearly API Response Time'
                );

            </text>
        }

        }

        // =========================================================
        // DOM Ready
        // =========================================================

        document.addEventListener(
        'DOMContentLoaded',
        function () {
        initializeCharts();
        }
        );

        // =========================================================
        // Re-render charts when <details> opens
        // =========================================================

        document
        .querySelectorAll('details')
        .forEach(function (details) {

        details.addEventListener(
        'toggle',
        function () {

        if (!details.open) {
        return;
        }

        setTimeout(
        function () {

        @for (var i = 0; i < Model.Statistics.Count; i++)
        {
            var api = Model.Statistics[i];

            <text>

                createStatisticsChart(
                'dailyChart_@i',
                @Html.Raw(Model.ToJson(api.Daily)),
                'Daily API Response Time'
                );

                createStatisticsChart(
                'monthlyChart_@i',
                @Html.Raw(Model.ToJson(api.Monthly)),
                'Monthly API Response Time'
                );

                createStatisticsChart(
                'yearlyChart_@i',
                @Html.Raw(Model.ToJson(api.Yearly)),
                'Yearly API Response Time'
                );

            </text>
        }

        },
        50
        );

        }
        );

        });

    </script>

</div>
