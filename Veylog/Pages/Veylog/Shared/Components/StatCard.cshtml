@{
    var title = (string)ViewBag.Title ?? "Metric";
    var value = ViewBag.Value;
    var textClass = (string?)ViewBag.TextClass ?? "";
}

<div class="col-md-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h6 class="text-muted">@title</h6>
            <h2 class="@textClass">@value</h2>
        </div>
    </div>
</div>
