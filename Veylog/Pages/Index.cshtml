@page "/veylog"
@model Veylog.Pages.IndexModel

@{
    ViewData["Title"] = "Veylog Dashboard";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Veylog Dashboard</h1>

        <div>
            <a href="/veylog/apis" class="btn btn-primary">
                API Requests
            </a>

            <a href="/veylog/sqls" class="btn btn-secondary">
                SQL Calls
            </a>
        </div>
    </div>

    <div class="row mb-4">

        @{
            ViewBag.Title = "Total Requests";
            ViewBag.Value = Model.TotalRequests;
        }
        @await Html.PartialAsync("Shared/Components/StatCard")

        @{
            ViewBag.Title = "Errors";
            ViewBag.Value = Model.Errors;
            ViewBag.TextClass = "text-danger";
        }
        @await Html.PartialAsync("Shared/Components/StatCard")

        @{
            ViewBag.Title = "Success";
            ViewBag.Value = Model.TotalRequests - Model.Errors;
            ViewBag.TextClass = "text-success";
        }
        @await Html.PartialAsync("Shared/Components/StatCard")

    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            Latest API Requests
        </div>

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Method</th>
                        <th>Path</th>
                        <th>Status</th>
                        <th>Duration</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var log in Model.Logs)
                    {
                        ViewBag.Log = log;
                        @await Html.PartialAsync("Shared/Components/ApiLogRow")
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>